# Copy to server/.env for local dev. On Render, set these in the Web Service's Environment tab.

# Postgres connection string (Render injects this automatically if you use render.yaml's
# `fromDatabase` binding; set it manually for local dev against your own Postgres+PostGIS instance)
DATABASE_URL=postgres://borla:borla@localhost:5432/borla

# JWT signing secrets — generate real random strings for anything beyond local dev,
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# Port the Express server listens on (Render sets this itself in production)
PORT=4000

# Optional: real AI moderation. Get a free-tier key from https://aistudio.google.com/apikey
# (no card required). Leave blank to run with manual-only moderation (reviews land straight
# in the admin queue instead of being auto-screened) — see Technical Debt Plan §AI moderation.
GEMINI_API_KEY=

# CORS origin allowed to call the API when the client is served from a different origin during
# local dev (Vite dev server). Not needed in production — the server serves the built client
# from the same origin.
CLIENT_ORIGIN=http://localhost:5173

NODE_ENV=development
