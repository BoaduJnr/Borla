{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "types": ["vite/client"]
  },
  "include": ["src"],
  // sw.ts runs in the service worker global scope (WebWorker lib), not the browser window (DOM
  // lib) — the two declare conflicting globals (e.g. `self`), so it gets its own program
  // (tsconfig.sw.json) instead of joining this one.
  "exclude": ["src/sw.ts"]
}
